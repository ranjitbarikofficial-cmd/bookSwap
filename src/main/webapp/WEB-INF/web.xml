<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
         version="6.1">

  <display-name>BookSwap</display-name>

  <!-- Existing seller dashboard -->
  <servlet>
    <servlet-name>SellerController</servlet-name>
    <servlet-class>Controller.SellerController</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>SellerController</servlet-name>
    <url-pattern>/seller/dashboard</url-pattern>
  </servlet-mapping>

  <!-- Book management -->
  <servlet>
    <servlet-name>BookController</servlet-name>
    <servlet-class>Controller.BookController</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>BookController</servlet-name>
    <url-pattern>/books/add</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>BookController</servlet-name>
    <url-pattern>/books/list</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>BookController</servlet-name>
    <url-pattern>/books/details</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>BookController</servlet-name>
    <url-pattern>/books/edit</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>BookController</servlet-name>
    <url-pattern>/books/delete</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>BookController</servlet-name>
    <url-pattern>/books/my-books</url-pattern>
  </servlet-mapping>

  <!-- Swap Request management -->
  <servlet>
    <servlet-name>SwapRequestController</servlet-name>
    <servlet-class>Controller.SwapRequestController</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>SwapRequestController</servlet-name>
    <url-pattern>/swaps/requests</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>SwapRequestController</servlet-name>
    <url-pattern>/swaps/sent</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>SwapRequestController</servlet-name>
    <url-pattern>/swaps/received</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>SwapRequestController</servlet-name>
    <url-pattern>/swaps/create</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>SwapRequestController</servlet-name>
    <url-pattern>/swaps/accept</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>SwapRequestController</servlet-name>
    <url-pattern>/swaps/reject</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>SwapRequestController</servlet-name>
    <url-pattern>/swaps/complete</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>SwapRequestController</servlet-name>
    <url-pattern>/swaps/history</url-pattern>
  </servlet-mapping>

</web-app>
